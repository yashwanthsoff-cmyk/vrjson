// IDE LINT NOTE: TypeScript IDE shows deprecation warnings for baseUrl and rootDir.
// These are IDE-only warnings (not tsc errors) due to:
// 1. Server imports from parent ../src directory (shared frontend code)
// 2. baseUrl is required for @engine/* and @contract path aliases
// 3. Cannot set rootDir without breaking cross-directory imports
// ACTUAL BUILD: npm run typecheck passes successfully.
// ACTION: These warnings can be safely ignored or suppressed in IDE settings.
// Migration needed when upgrading to TypeScript 7.0.

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["../src/engine/*"],
      "@contract": ["../src/types/contract.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../src/**/*.tsx", "../src/**/*.ts"]
}

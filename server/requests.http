POST {{baseUrl}}/drift-summary
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "userId": "u-meera",
  "from": "2026-01-01T00:00:00Z",
  "to": "2026-10-23T00:00:00Z",
  "showNames": true
}

#####################################
# Dev Flags (Non-Production Only)
#####################################

### Set Dev Flags
POST {{baseUrl}}/dev/flags
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "corruptSnapshotId": "snap-google-20261023"
}

### Set Connector Error Flag
POST {{baseUrl}}/dev/flags
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "simulateConnectorError": {
    "google_workspace": true
  }
}

### Reset Simulated Data
POST {{baseUrl}}/dev/reset
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{}


#####################################
# F-03 Granted-vs-Used Detector Requests
#####################################

### F03: Get Activity Events
GET {{baseUrl}}/activity?limit=20
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Get Activity Summary
GET {{baseUrl}}/activity/summary
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: List Mapping Rules
GET {{baseUrl}}/mapping-rules
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Test Mapping Glob Pattern
POST {{baseUrl}}/mapping/test
Content-Type: application/json
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

{
  "action": "drive.file.create",
  "app": "google_workspace"
}

### F03: Create Mapping Rule (Session Overlay)
POST {{baseUrl}}/mapping-rules
Content-Type: application/json
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

{
  "app": "google_workspace",
  "actionPattern": "drive.export.*",
  "entitlementId": "e-drive-admin",
  "note": "Custom export rule in session"
}

### F03: Get Ingest Runs
GET {{baseUrl}}/ingest-runs
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Simulate Ingest Run
POST {{baseUrl}}/ingest/simulate
Content-Type: application/json
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

{
  "app": "google_workspace"
}

### F03: Get Observation Windows
GET {{baseUrl}}/observation-windows
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Get Usage Rows
GET {{baseUrl}}/usage?limit=20
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Get Single Usage Row
GET {{baseUrl}}/usage/u-karthik/e-drive-admin
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Get Usage Findings
GET {{baseUrl}}/usage/findings
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### F03: Stateless Usage Evaluation
POST {{baseUrl}}/usage/evaluate
Content-Type: application/json
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

{
  "user": { "id": "test-eval", "startDate": "2024-01-01T00:00:00Z", "role": "Developer" },
  "entitlement": {
    "id": "e-eval",
    "app": "google_workspace",
    "name": "Eval Ent",
    "privilegeLevel": "standard",
    "dataSensitivity": "internal",
    "categories": ["Storage"]
  },
  "activityTimestamps": ["2026-10-01T00:00:00Z"]
}


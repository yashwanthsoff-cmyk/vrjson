#####################################
# Schedule
#####################################

### Get All Schedules
GET {{baseUrl}}/schedule
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}

### Update Schedule
PUT {{baseUrl}}/schedule/google_workspace
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "frequency": "daily",
  "enabled": true,
  "actorId": "rev-asha"
}

#####################################
# Sync Simulate
#####################################

### Simulate Sync Without Change
POST {{baseUrl}}/sync/simulate
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "app": "google_workspace",
  "withChange": false,
  "actorId": "rev-asha"
}

### Simulate Sync With Change
POST {{baseUrl}}/sync/simulate
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "app": "google_workspace",
  "withChange": true,
  "actorId": "rev-asha"
}

#####################################
# Replay Check
#####################################

### Run Replay Check on All Snapshots
POST {{baseUrl}}/replay-check
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{}

### Run Replay Check on Specific Snapshot
POST {{baseUrl}}/replay-check
x-actor-id: {{actorId}}
x-session-id: {{sessionId}}
Content-Type: application/json

{
  "snapshotId": "snap-google-20261023"
}

